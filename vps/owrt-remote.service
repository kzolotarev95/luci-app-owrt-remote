[Unit]
Description=OpenWrt Remote Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OWRT_REMOTE_BIND=0.0.0.0
Environment=OWRT_REMOTE_PORT=8088
Environment=OWRT_REMOTE_EXTRA_PORTS=80
Environment=OWRT_REMOTE_STATE_DIR=/var/lib/owrt-remote
ExecStart=/opt/owrt-remote/owrt-remote-hub.py serve --host 0.0.0.0 --port 8088
Restart=on-failure
RestartSec=3
DynamicUser=no

[Install]
WantedBy=multi-user.target
