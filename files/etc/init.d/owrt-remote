#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

uci_get() {
	local key default value
	key="$1"
	default="$2"
	value="$(uci -q get "owrtremote.main.$key" 2>/dev/null || true)"
	[ -n "$value" ] && {
		printf '%s' "$value"
		return
	}
	printf '%s' "$default"
}

config_enabled() {
	case "$(uci_get enabled 0)" in
		1|yes|true|on|enabled) return 0 ;;
		*) return 1 ;;
	esac
}

xray_pids() {
	local config cmdline cmd pid
	config="$(uci_get xray_config /etc/xray/owrt-remote-client.json)"
	[ -n "$config" ] || return 0
	for cmdline in /proc/[0-9]*/cmdline; do
		[ -r "$cmdline" ] || continue
		cmd="$(tr '\000' ' ' <"$cmdline" 2>/dev/null || true)"
		case "$cmd" in
			*xray*"$config"*|*xray-core*"$config"*)
				pid="${cmdline%/cmdline}"
				pid="${pid##*/}"
				printf '%s\n' "$pid"
				;;
		esac
	done
}

stop_xray_processes() {
	local pids pid
	pids="$(xray_pids)"
	for pid in $pids; do
		kill "$pid" >/dev/null 2>&1 || true
	done
	sleep 1
	for pid in $pids; do
		kill -0 "$pid" >/dev/null 2>&1 && kill -9 "$pid" >/dev/null 2>&1 || true
	done
}

start_service() {
	mkdir -p /var/lock /var/run /tmp/owrt-xray
	if [ -x /etc/init.d/owrt-remote-logs ]; then
		/etc/init.d/owrt-remote-logs start >/dev/null 2>&1 || true
	fi
	logger -t owrt-remote 'Сервис: запуск' 2>/dev/null || true

	if ! config_enabled; then
		echo "owrt-remote disabled in /etc/config/owrtremote"
		return 0
	fi

	# A remote Xray stop must survive service reloads without stopping Heartbeat.
	if [ ! -e /etc/owrt-remote/control/stopped ]; then
		procd_open_instance xray
		procd_set_param command /usr/sbin/owrt-remote run
		procd_set_param env OWRT_REMOTE_SERVICE_LOG=1
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	procd_open_instance heartbeat
	procd_set_param command /usr/sbin/owrt-remote heartbeat-loop
	procd_set_param env OWRT_REMOTE_SERVICE_LOG=1
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

stop_service() {
	logger -t owrt-remote 'Сервис: остановка туннеля' 2>/dev/null || true
	stop_xray_processes
	/usr/sbin/owrt-remote wan-cleanup >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger owrtremote
}
