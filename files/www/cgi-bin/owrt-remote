<script src="/luci-static/resources/owrt_remote_effects.js?v=$OWRT_REMOTE_UI_VERSION"></script>
<script>
(function() {
  var effectsPanel = document.getElementById('routerEffectsPanel');
  var effectsToggle = document.getElementById('routerEffectsToggle');
  var panel = document.getElementById('globalLogsPanel');
  var toggle = document.getElementById('globalLogsToggle');
  var close = document.getElementById('globalLogsClose');
  var live = document.getElementById('globalLogsLive');
  var clear = document.getElementById('globalLogsClear');
  var output = document.getElementById('globalLogsText');
  var status = document.getElementById('globalLogsStatus');
  var timer = null, controller = null, generation = 0, running = false;
  var renderedText = null;
  function setEffectsOpen(open) {
    if (!effectsPanel || !effectsToggle) return;
    effectsPanel.hidden = !open;
    effectsToggle.dataset.open = open ? 'true' : 'false';
    effectsToggle.dataset.active = open ? 'true' : 'false';
    effectsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  if (effectsToggle) effectsToggle.addEventListener('click', function(event) {
    event.stopPropagation();
    setEffectsOpen(!!effectsPanel && effectsPanel.hidden);
  });
  document.getElementById('routerEffectsClose').addEventListener('click', function() { setEffectsOpen(false); (document.getElementById('routerSidebar').inert ? document.getElementById('routerSidebarMenu') : effectsToggle).focus(); });
  if (effectsPanel) effectsPanel.addEventListener('click', function(event) { event.stopPropagation(); });
  document.addEventListener('click', function(event) {
    if (effectsPanel && effectsToggle && !effectsPanel.hidden && !effectsPanel.contains(event.target) && !effectsToggle.contains(event.target)) setEffectsOpen(false);
  });
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape' && effectsPanel && !effectsPanel.hidden) {
      setEffectsOpen(false);
      (window.matchMedia('(max-width:680px),(max-width:1024px) and (orientation:landscape) and (pointer:coarse)').matches ? document.getElementById('routerSidebarMenu') : effectsToggle).focus();
    }
  });
  function lineTone(line) {
    if (/^\[ERROR\]/.test(line)) return 'globalLogError';
    if (/^\[WARN\]/.test(line)) return 'globalLogWarn';
    if (/^\[OK\]/.test(line)) return 'globalLogOk';
    var message = line.replace(/^.*?owrt-remote(?:\[\d+\])?:\s*/, '');
    if (/core: Xray .* started/i.test(message)) return 'globalLogOk';
    if (/\[error\]|ошибка|не удалось|результат=bad|failed|cannot |could not |error:|syntax error|permission denied|network is unreachable|connection (refused|reset)|timed out|not permitted|no selected wan|wan has no|wan direct requires|already used by another rule|does not belong to remote|не применилось|dns failed|crash loop/i.test(message)) return 'globalLogError';
    if (/\[warn(?:ing)?\]|предупреждение|результат=warn|retry|not ready|missing|не найден|postponed|dns unavailable|fallback|reconnecting|restarting|failover/i.test(message)) return 'globalLogWarn';
    return 'globalLogOk';
  }
  function renderLogs(text, empty) {
    if (renderedText === text && output.querySelector('.globalLogLine')) return;
    var atBottom = output.scrollHeight - output.clientHeight - output.scrollTop < 24;
    var previousTop = output.scrollTop;
    var fragment = document.createDocumentFragment();
    var lines = text ? text.replace(/\r\n/g, '\n').replace(/\n$/, '').split('\n') : [empty];
    lines.forEach(function(line) {
      var row = document.createElement('span');
      row.className = 'globalLogLine ' + lineTone(line);
      row.textContent = line || ' ';
      fragment.appendChild(row);
    });
    output.textContent = '';
    output.appendChild(fragment);
    renderedText = text;
    output.scrollTop = atBottom ? output.scrollHeight : previousTop;
  }
  function endpoint(action) {
    var url = new URL(window.location.href);
    url.searchParams.set('action', action);
    url.searchParams.delete('_');
    return url;
  }
  function stop() {
    running = false;
    generation++;
    if (timer !== null) window.clearTimeout(timer);
    timer = null;
    if (controller) controller.abort();
    controller = null;
    live.textContent = 'Запустить в реальном времени';
    live.setAttribute('aria-pressed', 'false');
  }
  async function refresh(once) {
    if ((!running && !once) || panel.hidden || document.hidden) return;
    var current = generation;
    var request = new AbortController();
    controller = request;
    var timeout = window.setTimeout(function() { request.abort(); }, 10000);
    try {
      var response = await fetch(endpoint('logs_live'), {cache: 'no-store', signal: request.signal});
      if (!response.ok) throw new Error('HTTP ' + response.status);
      var text = await response.text();
      if (current !== generation || (!running && !once)) return;
      if ((response.headers.get('Content-Type') || '').indexOf('text/plain') !== 0) throw new Error('Доступ к журналу завершён. Открой панель заново.');
      renderLogs(text, once ? 'Журнал пока пуст. Новые записи появятся после действий в панели или событий Remote. Нажми «Запустить в реальном времени», чтобы увидеть их.' : 'Журнал пуст. Новые события появятся автоматически.');
      status.textContent = (once ? 'Сохранённые записи' : 'Просмотр в реальном времени') + ' · обновлено ' + new Date().toLocaleTimeString() + ' · последние 64 КБ журнала' + (once ? '. Для автообновления нажми «Запустить в реальном времени».' : '');
    } catch (error) {
      if (current === generation && (running || once)) {
        status.textContent = 'Не удалось получить логи: ' + error.message + (once ? '. Для повторной загрузки нажми «Запустить в реальном времени».' : '. Повтор через 3 секунды.');
        if (once) output.textContent = 'Записи журнала не загружены. Ошибка указана выше.';
      }
    } finally {
      window.clearTimeout(timeout);
      if (controller === request) controller = null;
      if (!once && current === generation && running && !panel.hidden && !document.hidden) timer = window.setTimeout(refresh, 3000);
    }
  }
  toggle.addEventListener('click', function() {
    panel.hidden = !panel.hidden;
    toggle.setAttribute('aria-expanded', String(!panel.hidden));
    if (panel.hidden) { stop(); status.textContent = 'Просмотр остановлен.'; }
    else {
      stop();
      output.textContent = 'Загрузка записей журнала…';
      status.textContent = 'Загружаю сохранённые записи с роутера…';
      refresh(true);
    }
  });
  close.addEventListener('click', function() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    stop();
    status.textContent = 'Просмотр остановлен.';
  });
  live.addEventListener('click', function() {
    if (running) { stop(); status.textContent = 'Просмотр остановлен.'; return; }
    stop();
    running = true;
    generation++;
    live.textContent = 'Остановить просмотр';
    live.setAttribute('aria-pressed', 'true');
    refresh();
  });
  clear.addEventListener('click', async function() {
    var resume = running;
    stop();
    clear.disabled = true;
    live.disabled = true;
    var request = new AbortController();
    var timeout = window.setTimeout(function() { request.abort(); }, 10000);
    try {
      var response = await fetch(endpoint('logs_clear'), {method: 'POST', cache: 'no-store', signal: request.signal});
      var text = await response.text();
      if (!response.ok || (response.headers.get('Content-Type') || '').indexOf('text/plain') !== 0) throw new Error('HTTP ' + response.status);
      output.textContent = 'Журнал очищен.';
      status.textContent = text.trim();
    } catch (error) { status.textContent = 'Не удалось очистить логи: ' + error.message; }
    finally {
      window.clearTimeout(timeout);
      clear.disabled = false;
      live.disabled = false;
      if (resume && !panel.hidden) { running = true; generation++; live.textContent = 'Остановить просмотр'; live.setAttribute('aria-pressed', 'true'); refresh(); }
    }
  });
  document.addEventListener('visibilitychange', function() {
    if (!running) return;
    generation++;
    if (timer !== null) window.clearTimeout(timer);
    timer = null;
    if (controller) controller.abort();
    if (!document.hidden) refresh();
  });
  window.addEventListener('pagehide', stop);
})();
(function initRouterSidebar() {
  var sidebar = document.getElementById('routerSidebar');
  var menu = document.getElementById('routerSidebarMenu');
  var backdrop = document.getElementById('routerSidebarBackdrop');
  var workspace = document.getElementById('routerWorkspace');
  var mq = window.matchMedia('(max-width:680px),(max-width:1024px) and (orientation:landscape) and (pointer:coarse)');
  function setOpen(open, restore) {
    var active = Boolean(open && mq.matches);
    sidebar.classList.toggle('is-open', active);
    sidebar.inert = mq.matches && !active;
    workspace.inert = active;
    backdrop.hidden = !active;
    menu.setAttribute('aria-expanded', String(active));
    document.body.classList.toggle('routerSidebarOpen', active);
    if (active) document.getElementById('routerSidebarClose').focus({preventScroll:true});
    else if (restore && mq.matches) menu.focus({preventScroll:true});
  }
  menu.addEventListener('click', function() { setOpen(!sidebar.classList.contains('is-open')); });
  document.getElementById('routerSidebarClose').addEventListener('click', function() { setOpen(false,true); });
  backdrop.addEventListener('click', function() { setOpen(false,true); });
  sidebar.querySelectorAll('[data-router-section]').forEach(function(link) {
    link.addEventListener('click', function(event) {
      var target = document.getElementById(link.dataset.routerSection);
      if (!target) return;
      event.preventDefault();
      sidebar.querySelectorAll('[data-router-section]').forEach(function(item) { item.classList.toggle('is-active',item.dataset.routerSection===link.dataset.routerSection); });
      setOpen(false);
      target.scrollIntoView({block:'start',behavior:document.documentElement.dataset.hubDesign==='lite' || window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth'});
      var heading=target.querySelector('h2');
      if (heading) { heading.tabIndex=-1; heading.focus({preventScroll:true}); }
    });
  });
  document.getElementById('globalLogsToggle').addEventListener('click', function() {
    setOpen(false);
    var panel=document.getElementById('globalLogsPanel');
    if (!panel.hidden) { panel.scrollIntoView({block:'start'}); var heading=panel.querySelector('h2'); heading.tabIndex=-1; heading.focus({preventScroll:true}); }
  });
  document.getElementById('routerEffectsToggle').addEventListener('click', function() {
    setOpen(false);
    if (!document.getElementById('routerEffectsPanel').hidden) document.getElementById('routerEffectsClose').focus({preventScroll:true});
  });
  document.addEventListener('keydown', function(event) {
    if (event.key==='Escape' && sidebar.classList.contains('is-open')) { event.preventDefault(); setOpen(false,true); }
    if (event.key!=='Tab' || !sidebar.classList.contains('is-open')) return;
    var focusable=Array.from(sidebar.querySelectorAll('button,a,summary')).filter(function(el) {return !el.disabled && el.getClientRects().length;});
    var first=focusable[0],last=focusable[focusable.length-1];
    if (event.shiftKey && document.activeElement===first) { event.preventDefault();last.focus(); }
    else if (!event.shiftKey && document.activeElement===last) { event.preventDefault();first.focus(); }
  });
  function onResize() { var restore=sidebar.contains(document.activeElement);setOpen(false,restore); }
  if (mq.addEventListener) mq.addEventListener('change',onResize); else mq.addListener(onResize);
  setOpen(false);
})();
document.querySelectorAll('[data-wan-picker]').forEach(function(picker) {
  var field = picker.closest('.wanField');
  var inputs = Array.from(picker.querySelectorAll('input[name="wan_interface"]'));
  function updateSelection() {
    var selected = inputs.filter(function(input) { return input.checked; }).map(function(input) { return input.value; });
    field.querySelector('[data-wan-count]').textContent = selected.length;
    field.querySelector('[data-wan-picked]').textContent = selected.length ? selected.join(', ') : 'Интерфейсы не выбраны';
  }
  picker.addEventListener('change', updateSelection);
  updateSelection();
});
