}

read_request

if ! authorized; then
	render_unauthorized
	exit 0
fi

action="$(param action)"

if [ "$action" = "download_config" ]; then
	http_json
	"$AGENT" render-client --stdout 2>&1
	exit 0
fi

if [ "${REQUEST_METHOD:-GET}" = "POST" ]; then
	case "$action" in
		save)
			save_config
			;;
		save_start)
			save_config
			run_action start
			;;
		start|stop|restart|heartbeat|doctor)
			run_action "$action"
			;;
	esac
fi

render_page
