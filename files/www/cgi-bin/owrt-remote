.brand{display:flex;gap:14px;align-items:center}.mark{width:54px;height:54px;border-radius:8px;background:#0f766e;color:#fff;display:grid;place-items:center;font-weight:800;font-size:24px;box-shadow:0 12px 30px rgba(15,118,110,.22)}
h1{margin:0;font-size:28px;letter-spacing:0}.sub{margin:4px 0 0;color:var(--muted)}
.pill{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:8px 12px;color:var(--muted);white-space:nowrap}.dot{width:9px;height:9px;border-radius:50%;background:var(--amber)}.dot.good{background:var(--green)}.dot.bad{background:var(--red)}
.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:16px;margin-top:18px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:16px;box-shadow:0 10px 28px rgba(20,35,60,.05)}
.panel h2{font-size:18px;margin:0 0 12px}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.metric{border:1px solid var(--line);border-radius:8px;padding:12px;background:#fafcff}.metric span{display:block;color:var(--muted);font-size:12px}.metric strong{display:block;margin-top:4px;font-size:18px;word-break:break-word}.metric.good strong{color:var(--green)}.metric.bad strong{color:var(--red)}.metric.warn strong{color:var(--amber)}
form{margin:0}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:block}.field span{display:block;font-weight:650;margin-bottom:6px}.field input{width:100%;border:1px solid var(--line);border-radius:8px;background:#fff;padding:10px 11px;color:var(--text)}.field small{display:block;margin-top:5px;color:var(--muted)}
.check{display:flex;gap:10px;align-items:center;margin-bottom:12px;font-weight:700}.check input{width:18px;height:18px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}.btn{border:0;border-radius:8px;padding:10px 13px;font-weight:750;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;background:#e8eef8;color:#1f2a44}.btn.primary{background:var(--blue);color:#fff}.btn.good{background:var(--green);color:#fff}.btn.bad{background:#fee2e2;color:#991b1b}.btn.warn{background:#fff7ed;color:#9a3412;border:1px solid #fed7aa}
.notice{margin-top:16px;border-radius:8px;padding:12px;border:1px solid var(--line);background:#f8fbff;white-space:pre-wrap}.notice.ok{border-color:#bbf7d0;background:#f0fdf4}.notice.bad{border-color:#fecaca;background:#fef2f2}.notice.warn{border-color:#fed7aa;background:#fff7ed}
.code{background:#101827;color:#d7e2f2;border-radius:8px;padding:12px;overflow:auto;min-height:120px;font:12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}
@media(max-width:820px){.grid,.formgrid,.metrics{grid-template-columns:1fr}.hero{align-items:flex-start;flex-direction:column}.wrap{padding:14px}h1{font-size:24px}}
</style>
</head>
<body>
<main class="wrap">
  <section class="hero">
    <div class="brand">
      <div class="mark">R</div>
      <div>
        <h1>OpenWrt Remote</h1>
        <p class="sub">$(h "$router_name") · $(h "$router_id") · $(h "$status_text")</p>
      </div>
    </div>
    <div class="pill"><span class="dot $(h "$xray_tone")"></span>Xray: $(h "$xray_state")</div>
  </section>

  <section class="grid">
    <div class="panel">
      <h2>Состояние</h2>
      <div class="metrics">
EOF
	metric "procd service" "$service_state" "$service_tone"
	metric "xray tunnel" "$xray_state" "$xray_tone"
	metric "VPS host" "${vps_host:-не задан}" ""
	metric "Hub URL" "${hub_url:-не задан}" ""
	cat <<EOF
      </div>
      <form method="post" class="actions">
        <input type="hidden" name="key" value="$(h "$key")">
        <button class="btn good" name="action" value="start">Запустить</button>
        <button class="btn warn" name="action" value="restart">Перезапустить</button>
        <button class="btn bad" name="action" value="stop">Остановить</button>
        <button class="btn" name="action" value="heartbeat">Heartbeat</button>
        <button class="btn" name="action" value="doctor">Проверка</button>
        <a class="btn" href="?key=$(h "$key")&action=download_config">Скачать Xray config</a>
      </form>
EOF
	if [ -n "$RESULT_TITLE" ]; then
		printf '<div class="notice %s"><strong>%s</strong>\n%s</div>' "$(h "$RESULT_KIND")" "$(h "$RESULT_TITLE")" "$(h "$RESULT_BODY")"
	fi
	cat <<EOF
    </div>

    <div class="panel">
      <h2>Шпаргалка</h2>
      <div class="code">/etc/init.d/owrt-remote enable
/etc/init.d/owrt-remote restart
owrt-remote heartbeat
owrt-remote status</div>
    </div>
  </section>

  <section class="panel" style="margin-top:16px">
    <h2>Настройки роутера</h2>
    <form method="post">
      <input type="hidden" name="key" value="$(h "$key")">
      <label class="check"><input type="checkbox" name="enabled" value="1" $enabled_checked> Включить агент и автозапуск</label>
      <div class="formgrid">
EOF
	field router_id "Router ID" text "Например main или office-1"
	field router_name "Название" text "Будет видно на VPS-карточке"
	field role "Роль" text "main для главного, node для остальных"
	field public_url "Public URL" text "Можно оставить пустым, если используешь proxy через hub"
	field hub_url "Hub URL" text "Например https://vps.example.com:8088"
	field hub_token "Hub token" password "AGENT_TOKEN с VPS"
	field heartbeat_interval "Heartbeat, секунд" number "Минимум 10"
	field xray_bin "Xray binary" text "/usr/bin/xray"
	field xray_config "Xray config" text "/etc/xray/owrt-remote-client.json"
	field vps_host "VPS host" text "IP или домен VPS для Xray"
	field vps_port "VPS Xray port" number "Обычно 8443"
	field vless_uuid "VLESS UUID" text "Из карточки роутера на VPS"
	field vless_encryption "VLESS encryption" text "По умолчанию none"
	field vless_flow "VLESS flow" text "Обычно пусто"
	field reverse_tag "Reverse tag" text "Обычно reverse-in"
	field admin_host "Admin host" text "Обычно 127.0.0.1"
	field admin_port "Admin port" number "LuCI/uhttpd обычно 80"
	cat <<EOF
      </div>
      <div class="actions">
        <button class="btn primary" name="action" value="save">Сохранить</button>
        <button class="btn good" name="action" value="save_start">Сохранить и запустить</button>
      </div>
    </form>
  </section>
</main>
</body>
</html>
EOF
}

read_request

if ! authorized; then
	render_unauthorized
	exit 0
fi

action="$(param action)"

if [ "$action" = "download_config" ]; then
	http_json
	"$AGENT" render-client --stdout 2>&1
	exit 0
fi

if [ "${REQUEST_METHOD:-GET}" = "POST" ]; then
	case "$action" in
		save)
			save_config
			;;
		save_start)
			save_config
			run_action start
			;;
		start|stop|restart|heartbeat|doctor)
			run_action "$action"
			;;
	esac
fi

render_page

