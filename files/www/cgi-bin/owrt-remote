          <a href="https://github.com/kzolotarev95" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
    <div class="topActions">
      <div class="pill"><span class="dot $(h "$xray_tone")"></span>Xray: $(h "$xray_state")</div>
    </div>
  </section>

  <section class="grid">
    <div class="panel">
      <h2>Состояние</h2>
      <div class="metrics">
EOF
	metric "procd service" "$service_state" "$service_tone"
	metric "xray tunnel" "$xray_state" "$xray_tone"
	metric "VPS host" "${vps_host:-не задан}" ""
	metric "Hub URL" "${hub_url:-не задан}" ""
	cat <<EOF
      </div>
      <form method="post" class="actions">
        <input type="hidden" name="key" value="$(h "$key")">
        <button class="btn good" name="action" value="start">Запустить</button>
        <button class="btn warn" name="action" value="restart">Перезапустить</button>
        <button class="btn bad" name="action" value="stop">Остановить</button>
        <button class="btn" name="action" value="heartbeat">Heartbeat</button>
        <button class="btn" name="action" value="doctor">Проверка</button>
        <a class="btn" href="?key=$(h "$key")&action=download_config">Скачать Xray config</a>
      </form>
EOF
	if [ -n "$RESULT_TITLE" ]; then
		printf '<div class="notice %s"><strong>%s</strong>\n%s</div>' "$(h "$RESULT_KIND")" "$(h "$RESULT_TITLE")" "$(h "$RESULT_BODY")"
	fi
	cat <<EOF
    </div>

    <div class="panel">
      <h2>Шпаргалка</h2>
