read_request

if ! authorized; then
	render_unauthorized
	exit 0
fi

action="$(param action)"

case "$action" in
	donate) render_donate_page; exit 0 ;;
	logs_download) logs_response download; exit 0 ;;
	logs_live) logs_response live; exit 0 ;;
	logs_clear) logs_response clear; exit 0 ;;
esac

if [ "${REQUEST_METHOD:-GET}" = POST ] && [ -n "$action" ] && [ -r "$LOG_HELPER" ]; then
	printf '' | sh "$LOG_HELPER" event "Панель: действие=$action; начало" >/dev/null 2>&1 || true
elif [ "${REQUEST_METHOD:-GET}" = GET ] && [ -z "$action" ] && [ -r "$LOG_HELPER" ]; then
	printf '' | sh "$LOG_HELPER" event 'Панель: открыта' >/dev/null 2>&1 || true
fi

if [ "$action" = "download_config" ]; then
	http_json
	"$AGENT" render-client --stdout 2>&1
	exit 0
fi

if [ "${REQUEST_METHOD:-GET}" = "POST" ]; then
	case "$action" in
		save)
			save_config
			;;
		save_start)
			if save_config; then run_action start; fi
			;;
		show_xray_settings)
			SHOW_XRAY_SETTINGS="1"
			;;
		apply_xray_settings)
			apply_xray_settings
			;;
		clear_config)
			clear_config
			;;
		start|stop|restart|heartbeat|doctor|install_xray_tmp)
			run_action "$action"
			;;
	esac
fi

render_page
